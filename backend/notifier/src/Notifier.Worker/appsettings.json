{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Kafka": {
    "Brokers": "",
    "GroupId": "notifier"
  },
  "Delivery": {
    "BatchSize": 50,
    "MaxAttempts": 5,
    "BaseBackoffSeconds": 2,
    "MaxBackoffSeconds": 60,
    "LeaseSeconds": 30,
    "PollIntervalMilliseconds": 500,
    "MaxParallelism": 16,
    "PublicBaseUrl": "http://localhost:3000",
    "Fallbacks": {
      "call": "sms",
      "sms": "email",
      "email": "ui"
    }
  },
  "Escalation": {
    "PushDelayMinutes": 5,
    "OnCallCallDelayMinutes": 10
  },
  "ConfigCache": {
    "CacheSeconds": 5
  },
  "Cleanup": {
    "IntervalMinutes": 10,
    "OutboxRetentionHours": 24,
    "ProcessedChangeRetentionHours": 168,
    "NotificationRetentionHours": 168
  },
  "Outbox": {
    "BatchSize": 100,
    "MaxAttempts": 10,
    "LeaseSeconds": 30,
    "PollIntervalMilliseconds": 200
  },
  "Channels": {
    "Enabled": [
      "ui",
      "email",
      "sms",
      "call"
    ],
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "EmailFrom": "Alerts <alerts@notifier.local>",
    "SmsGatewayUrl": "http://localhost:8002/sms",
    "CallGatewayUrl": "http://localhost:8002/call",
    "GatewayTimeoutSeconds": 2,
    "SmtpPoolSize": 4
  }
}
