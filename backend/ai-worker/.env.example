# Read by docker compose from backend/ai-worker/.env (copy this file there to change it).
# Without a key the worker runs and enqueues jobs, but runs none of the kinds that need that key:
# ANTHROPIC_API_KEY for mapping, runbook and proposal jobs, TYPESAFE_API_KEY for severity jobs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
LOG_LEVEL=INFO
# One JSON line per finished job attempt (relative to the working dir; compose mounts ./logs).
AGENT_METRICS_FILE=logs/agent-metrics.jsonl
