{"id": "first-prod-settlement-timeout", "mode": "first", "expected": "critical", "why": "A failed order settlement in prod means trades are not settling and money is stuck; the brief's own example phones the on-call person. Act now.", "rule": {"id": "settlements-prod", "team_id": "settlements", "name": "Order settlement failed in prod", "enabled": true, "when": {"all": [{"field": "type", "op": "eq", "value": "WORKFLOW_FAILED"}, {"field": "raw.workflowName", "op": "eq", "value": "order-settlement"}, {"field": "env", "op": "eq", "value": "prod"}]}, "route": {"recipients": [{"team": "settlements", "on_call": true}], "channels": ["call", "sms", "ui"]}, "present": {"title": "{{workflowName}} failed at step {{step}}", "body": "{{error.message}}"}, "severity": null}, "alert": {"title": "order-settlement failed at step settle", "body": "Counterparty service did not respond in 5000 ms", "fields": {"step": "settle", "error.code": "TIMEOUT"}, "type": "WORKFLOW_FAILED", "service": "order-settlement", "env": "prod", "severity": "critical"}}
