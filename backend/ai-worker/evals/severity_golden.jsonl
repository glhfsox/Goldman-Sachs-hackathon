{"id": "first-stg-settlement-failed", "mode": "first", "expected": "warning", "why": "The same workflow in staging: no real money; someone should look during working hours so testing is not blocked, nobody should be woken.", "rule": {"id": "settlements-stg", "team_id": "settlements", "name": "Order settlement failed in staging", "enabled": true, "when": {"all": [{"field": "type", "op": "eq", "value": "WORKFLOW_FAILED"}, {"field": "raw.workflowName", "op": "eq", "value": "order-settlement"}, {"field": "env", "op": "eq", "value": "staging"}]}, "route": {"recipients": [{"team": "settlements", "on_call": true}], "channels": ["email", "ui"]}, "present": {"title": "{{workflowName}} failed at step {{step}}", "body": "{{error.message}}"}, "severity": null}, "alert": {"title": "order-settlement failed at step settle", "body": "Counterparty service did not respond in 5000 ms", "fields": {"step": "settle", "error.code": "TIMEOUT"}, "type": "WORKFLOW_FAILED", "service": "order-settlement", "env": "staging", "severity": "critical"}}
