{"id": "first-prod-trade-rejected-large", "mode": "first", "expected": "error", "why": "A rejected 25M EUR rates trade has to be rebooked or escalated today, but it is one trade and a limit breach, not a system down; the brief routes it to email + UI, not a call.", "rule": {"id": "rates-large-rejects", "team_id": "rates", "name": "Large rates trade rejected", "enabled": true, "when": {"all": [{"field": "type", "op": "eq", "value": "trade.rejected.v1"}, {"field": "raw.payload.desk", "op": "eq", "value": "rates"}, {"field": "raw.payload.notional", "op": "gt", "value": 10000000}]}, "route": {"recipients": [{"team": "rates", "on_call": true}], "channels": ["email", "ui"]}, "present": {"title": "Rates trade {{payload.tradeId}} rejected: {{payload.reason}}"}, "severity": null}, "alert": {"title": "Rates trade T-88123 rejected: LIMIT_BREACH (25,000,000 EUR)", "body": "trade-gateway rejected trade T-88123 on desk rates", "fields": {"payload.notional": 25000000, "payload.currency": "EUR", "payload.reason": "LIMIT_BREACH"}, "type": "trade.rejected.v1", "service": "trade-gateway", "env": "prod", "severity": "warning"}}
